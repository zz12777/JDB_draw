{
  "rules": {
    "admins": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com')",
      ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com')",
      "$key": {
        ".read": "auth != null && auth.token.email.replace('.', ',') == $key",
        ".validate": "newData.hasChildren(['email', 'until']) && newData.child('until').isNumber() && newData.child('email').isString() && newData.child('email').val().length < 120"
      }
    },
    "t13": {
      "pub": {
        ".read": true,
        "meta": {
          ".write": "auth != null && auth.token.email_verified == true && ((auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com') || root.child('admins').child(auth.token.email.replace('.', ',')).child('until').val() > now)"
        },
        "events": {
          ".write": "auth != null && auth.token.email_verified == true && ((auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com') || root.child('admins').child(auth.token.email.replace('.', ',')).child('until').val() > now)"
        },
        "m": {
          ".indexOn": [
            "u"
          ],
          ".write": "auth != null && auth.token.email_verified == true && ((auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com') || root.child('admins').child(auth.token.email.replace('.', ',')).child('until').val() > now)",
          "$mid": {
            "u": {
              ".write": "data.parent().child('tables').exists() && data.parent().child('tables').val() != '[]' && data.parent().child('confirmed').val() != 'true'",
              ".validate": "newData.isNumber()"
            },
            "g": {
              ".write": "data.parent().child('tables').exists() && data.parent().child('tables').val() != '[]' && data.parent().child('confirmed').val() != 'true'",
              ".validate": "newData.isString() && newData.val().length < 400"
            },
            "ref": {
              ".write": "data.parent().child('tables').exists() && data.parent().child('tables').val() != '[]' && data.parent().child('confirmed').val() != 'true'",
              ".validate": "newData.isString() && newData.val().length < 60"
            },
            "refs": {
              ".write": "data.parent().child('tables').exists() && data.parent().child('tables').val() != '[]' && data.parent().child('confirmed').val() != 'true'",
              ".validate": "newData.isString() && newData.val().length < 400"
            },
            "absent": {
              ".write": "data.parent().child('tables').exists() && data.parent().child('tables').val() != '[]' && data.parent().child('confirmed').val() != 'true'",
              ".validate": "newData.isString() && newData.val().length < 200"
            },
            "pts": {
              "$i": {
                "g": {
                  ".write": "data.parent().parent().parent().child('tables').exists() && data.parent().parent().parent().child('tables').val() != '[]' && data.parent().parent().parent().child('confirmed').val() != 'true'",
                  ".validate": "newData.isString() && newData.val().length < 400"
                },
                "ref": {
                  ".write": "data.parent().parent().parent().child('tables').exists() && data.parent().parent().parent().child('tables').val() != '[]' && data.parent().parent().parent().child('confirmed').val() != 'true'",
                  ".validate": "newData.isString() && newData.val().length < 60"
                },
                "table": {
                  ".write": "data.parent().parent().parent().child('tables').exists() && data.parent().parent().parent().child('tables').val() != '[]' && data.parent().parent().parent().child('confirmed').val() != 'true'",
                  ".validate": "newData.isString() && newData.val().length < 10"
                },
                "absent": {
                  ".write": "data.parent().parent().parent().child('tables').exists() && data.parent().parent().parent().child('tables').val() != '[]' && data.parent().parent().parent().child('confirmed').val() != 'true'",
                  ".validate": "newData.isString() && newData.val().length < 200"
                }
              }
            }
          }
        }
      },
      "desk": {
        ".read": "auth != null && auth.token.email_verified == true && ((auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com') || root.child('admins').child(auth.token.email.replace('.', ',')).child('until').val() > now)",
        ".write": "auth != null && auth.token.email_verified == true && ((auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com') || root.child('admins').child(auth.token.email.replace('.', ',')).child('until').val() > now)"
      }
    },
    "branding": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified == true && ((auth.token.email == 'nctugtt@gmail.com' || auth.token.email == 'nctuttc@gmail.com') || root.child('admins').child(auth.token.email.replace('.', ',')).child('until').val() > now)",
      ".validate": "newData.hasChildren(['logo']) && newData.child('logo').isString() && newData.child('logo').val().length < 700000 && (!newData.child('icon').exists() || newData.child('icon').val().length < 100000)"
    }
  }
}